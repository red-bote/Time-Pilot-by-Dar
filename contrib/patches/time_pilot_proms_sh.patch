# New file: make_time_pilot_proms.sh, a bash port of make_time_pilot_proms.bat
# used by contrib/tools/user/roms.sh. Shipped as a patch so that make check reproduces it.
--- /dev/null
+++ b/vhdl_time_pilot_rev_0_0_2017_11_05/tools/time_pilot_unzip/make_time_pilot_proms.sh
@@ -0,0 +1,27 @@
+#!/bin/bash
+# Port of make_time_pilot_proms.bat for the Basys3 build. Run from this
+# directory (the unzipped timeplt.zip) by contrib/tools/roms.sh, which sets:
+#   MAKE_VHDL_PROM  path of the compiled make_vhdl_prom
+#   PROM_DIR        output directory for the PROM VHDL
+# make_vhdl_prom names the entity after its output argument, so it runs inside
+# PROM_DIR with bare output file names.
+
+set -euo pipefail
+
+: "${MAKE_VHDL_PROM:?}" "${PROM_DIR:?}"
+roms="$(pwd)"
+tmp="$(mktemp -d)"
+trap 'rm -rf "$tmp"' EXIT
+
+cat tm1 tm2 tm3 > "$tmp/time_pilot_prog.bin"
+cat tm4 tm5 > "$tmp/time_pilot_sprite_grphx.bin"
+
+cd "$PROM_DIR"
+"$MAKE_VHDL_PROM" "$tmp/time_pilot_prog.bin"         time_pilot_prog.vhd
+"$MAKE_VHDL_PROM" "$tmp/time_pilot_sprite_grphx.bin" time_pilot_sprite_grphx.vhd
+"$MAKE_VHDL_PROM" "$roms/tm6"                        time_pilot_char_grphx.vhd
+"$MAKE_VHDL_PROM" "$roms/tm7"                        time_pilot_sound_prog.vhd
+"$MAKE_VHDL_PROM" "$roms/timeplt.b4"                 time_pilot_palette_blue_green.vhd
+"$MAKE_VHDL_PROM" "$roms/timeplt.b5"                 time_pilot_palette_green_red.vhd
+"$MAKE_VHDL_PROM" "$roms/timeplt.e9"                 time_pilot_sprite_color_lut.vhd
+"$MAKE_VHDL_PROM" "$roms/timeplt.e12"                time_pilot_char_color_lut.vhd
